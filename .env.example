PORT=3100
MCP_HTTP_PORT=3210
# Optional bearer token for AXIOM HTTP MCP routes.
# When set, callers must send Authorization: Bearer <token> to /mcp/* and /tools/list.
MCP_WORKER_AUTH_TOKEN=
LOG_LEVEL=info
OUTPUT_DIR=outputs
LOG_DIR=logs
MAX_RETRIES=2
PYTHON_BIN=python
# Symbolic render accepts SoundFont files supported by FluidSynth, typically .sf2 or .sf3.
# Adopted default: MuseScore_General.sf3. Keep default.sf2 only as the benchmark baseline.
SOUNDFONT_PATH=assets/soundfonts/MuseScore_General.sf3
FFMPEG_BIN=ffmpeg
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:latest
OVERSEER_AUTO_ENABLED=true
OVERSEER_INTERVAL_MS=600000
AUTONOMY_ENABLED=true
AUTONOMY_SCHEDULER_ENABLED=true
AUTONOMY_SCHEDULER_POLL_MS=30000
AUTONOMY_SCHEDULER_INTERVAL_MS=0
AUTONOMY_SCHEDULER_TIME=10:30
AUTONOMY_SCHEDULER_TIMEZONE=Asia/Seoul
AUTONOMY_MAX_ATTEMPTS_PER_DAY=2
AUTONOMY_STALE_LOCK_MS=3600000
AUTONOMY_AUTO_CLEAR_STALE_LOCKS=true
RETRY_BACKOFF_MS=2000
MUSICGEN_TIMEOUT_MS=1800000
STRUCTURE_RERANKER_SHADOW_ENABLED=false
STRUCTURE_RERANKER_SHADOW_SNAPSHOT=
# Reuses the shadow snapshot above and only promotes the narrow string_trio symbolic lane.
STRUCTURE_RERANKER_PROMOTION_ENABLED=false

# Learned symbolic backend selection.
# template      – music21 symbolic path (default; NotaGen not loaded)
# notagen_mock  – deterministic mock ABC for CI/CD and integration tests
# notagen_local – real model inference (requires NOTAGEN_MODEL_PATH + requirements-notagen.txt)
LEARNED_SYMBOLIC_BACKEND=template

# Inference engine for notagen_local mode.
# hf_causal_lm    – generic HuggingFace AutoModelForCausalLM (default; experimental)
# notagen_native  – official NotaGen repo generate() API (production-quality; requires NOTAGEN_REPO_PATH)
NOTAGEN_ENGINE=hf_causal_lm

# notagen_native engine settings (only used when NOTAGEN_ENGINE=notagen_native).
# NOTAGEN_REPO_PATH: path to the cloned NotaGen repo (https://github.com/ElectricAlexis/NotaGen).
#   The repo's gradio/ subdirectory must contain utils.py and config.py.
# NOTAGEN_DEFAULT_PERIOD: NotaGen period label for AXIOM prompts that don't specify one.
#   Valid: Baroque | Classical | Romantic | 20th  (default: Romantic)
# NOTAGEN_DEFAULT_COMPOSER: NotaGen composer label for AXIOM prompts that don't specify one.
#   Must match the training-data vocabulary (e.g. "Brahms, Johannes").  (default: Brahms, Johannes)
NOTAGEN_REPO_PATH=
NOTAGEN_DEFAULT_PERIOD=Romantic
NOTAGEN_DEFAULT_COMPOSER=Brahms, Johannes

# Optional shared gcpCompute operator defaults for bootstrap and docs.
AXIOM_GCPCOMPUTE_HOST=fancy@34.56.232.61
AXIOM_GCPCOMPUTE_SHARED_RUNTIME_DIR=/opt/muel/shared-mcp-runtime
AXIOM_GCPCOMPUTE_SHARED_HEALTH_URL=https://34.56.232.61.sslip.io/mcp/health
