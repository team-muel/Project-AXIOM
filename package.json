{
    "name": "axiom",
    "version": "0.1.0",
    "description": "Autonomous classical music production pipeline",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "dev:core": "tsx watch src/index.core.ts",
        "start": "tsx src/index.ts",
        "start:core": "tsx src/index.core.ts",
        "start:mcp": "tsx src/ops/mcp/server.ts",
        "start:mcp:http": "tsx src/ops/mcp/httpServer.ts",
        "start:dist": "node dist/index.js",
        "start:core:dist": "node dist/index.core.js",
        "start:mcp:dist": "node dist/ops/mcp/server.js",
        "start:mcp:http:dist": "node dist/ops/mcp/httpServer.js",
        "build": "tsc",
        "test": "npm run test:unit",
        "test:unit": "node --test test/suites/unit.test.mjs",
        "test:piano": "node --test test/suites/piano.test.mjs",
        "test:core": "node --test test/suites/core.test.mjs",
        "test:python": "node --test test/suites/python.test.mjs",
        "test:ops": "node --test test/suites/ops.test.mjs",
        "test:slow": "node --test test/suites/slow.test.mjs",
        "test:all": "node --test test/all.test.mjs",
        "test:ci": "npm run build && npm run typecheck && npm run test:all",
        "test:profile": "node scripts/profile-tests.mjs",
        "typecheck": "tsc --noEmit",
        "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
        "benchmark:soundfont:metrics": "node scripts/generate-soundfont-benchmark-metrics.mjs",
        "benchmark:soundfont:playlist": "node scripts/generate-soundfont-benchmark-playlist.mjs",
        "benchmark:notagen-ablation": "node scripts/benchmark-notagen-control-ablation.mjs",
        "benchmark:notagen-ablation:json": "node scripts/benchmark-notagen-control-ablation.mjs --json",
        "benchmark:notagen-ablation:scores": "node scripts/benchmark-notagen-control-ablation.mjs --scores-from=outputs",
        "benchmark:notagen-ablation:scores:json": "node scripts/benchmark-notagen-control-ablation.mjs --scores-from=outputs --json",
        "analyze:score-feedback": "node scripts/analyze-score-feedback-correlation.mjs --root=outputs --out=outputs/_system/score-feedback-correlation.json --csv",
        "export:sft-dataset": "node scripts/export-sft-dataset.mjs --out=outputs/_system/sft-dataset.jsonl",
        "export:notagen-sft": "node scripts/export-notagen-sft-dataset.mjs --root=outputs",
        "export:notagen-sft:dry-run": "node scripts/export-notagen-sft-dataset.mjs --root=outputs --dry-run",
        "export:notagen-sft:selected-only": "node scripts/export-notagen-sft-dataset.mjs --root=outputs --selected-only"
    },
    "dependencies": {
        "dotenv": "^16.4.7",
        "express": "^5.1.0",
        "uuid": "^11.1.0"
    },
    "devDependencies": {
        "@types/express": "^5.0.2",
        "@types/node": "^22.15.2",
        "@types/uuid": "^10.0.0",
        "tsx": "^4.19.4",
        "typescript": "^5.8.3"
    }
}