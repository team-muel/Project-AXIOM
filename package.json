{
    "name": "axiom",
    "version": "0.1.0",
    "description": "Autonomous classical music production pipeline",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "dev:core": "tsx watch src/index.core.ts",
        "start": "tsx src/index.ts",
        "start:core": "tsx src/index.core.ts",
        "start:mcp": "tsx src/ops/mcp/server.ts",
        "start:mcp:http": "tsx src/ops/mcp/httpServer.ts",
        "start:dist": "node dist/index.js",
        "start:core:dist": "node dist/index.core.js",
        "start:mcp:dist": "node dist/ops/mcp/server.js",
        "start:mcp:http:dist": "node dist/ops/mcp/httpServer.js",
        "build": "tsc",
        "pretest": "npm run build",
        "test": "node --test test/all.test.mjs",
        "typecheck": "tsc --noEmit",
        "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
        "benchmark:soundfont:metrics": "node scripts/generate-soundfont-benchmark-metrics.mjs",
        "benchmark:soundfont:playlist": "node scripts/generate-soundfont-benchmark-playlist.mjs"
    },
    "dependencies": {
        "dotenv": "^16.4.7",
        "express": "^5.1.0",
        "uuid": "^11.1.0"
    },
    "devDependencies": {
        "@types/express": "^5.0.2",
        "@types/node": "^22.15.2",
        "@types/uuid": "^10.0.0",
        "tsx": "^4.19.4",
        "typescript": "^5.8.3"
    }
}